; On arm64_32, pointers are 32 bits in memory but live in 64-bit registers.
; Bitcasts, bitinserts and bitextracts that move the bits of a pointer into or
; out of a byte must use the 32-bit memory representation.

define b32 @test_bitcast_ptr_to_b32(ptr %p) {
; CHECK-LABEL: test_bitcast_ptr_to_b32:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ; kill: def $w0 killed $w0 killed $x0
; CHECK-NEXT:    ret
  %b = bitcast ptr %p to b32
  ret b32 %b
}

define ptr @test_bitcast_b32_to_ptr(b32 %b) {
; CHECK-LABEL: test_bitcast_b32_to_ptr:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    mov w0, w0
; CHECK-NEXT:    ret
  %p = bitcast b32 %b to ptr
  ret ptr %p
}

