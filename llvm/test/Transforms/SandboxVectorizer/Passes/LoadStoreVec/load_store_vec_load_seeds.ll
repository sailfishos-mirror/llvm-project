; CHECK-NEXT:    [[EXT:%.*]] = zext i16 [[LD1]] to i32
; CHECK-NEXT:    [[SUM:%.*]] = add i32 [[LD0]], [[EXT]]
; CHECK-NEXT:    ret i32 [[SUM]]
;
